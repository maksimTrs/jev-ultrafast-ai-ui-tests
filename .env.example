# Local mode: copy to .env and run `uv run --env-file .env pytest`. In Docker, compose.yaml sets these.

# Decision model: services/decision (laya-browser), a local TypeSafe-compatible /v1/systemone endpoint.
LAYA_URL=http://127.0.0.1:8791

# Text model for TYPE_TEXT: any OpenAI-compatible endpoint; here a local Ollama.
TEXT_MODEL_BASE_URL=http://127.0.0.1:11434/v1
TEXT_MODEL=gemma4:e4b
TEXT_MODEL_API_KEY=ollama
TEXT_MODEL_REASONING=none

# Optional: Chrome binary when it is not in a standard location.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
